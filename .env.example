# ── AI Backend (choose one) ───────────────────────────────────────────────────

# Option 1: Groq — FREE, fast, get key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Grok (xAI) — get key at console.x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# Option 2: IBM watsonx.ai + Granite
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# Optional: Override embedding model (used for RAG Q&A)
EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr

# App Settings
APP_TITLE=Smart Study Generator Agent
MAX_UPLOAD_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=64
